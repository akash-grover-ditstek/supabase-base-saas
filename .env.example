# -----------------------------------------------------------------------------
# Edge Function secrets
#
# Local:      copy to supabase/functions/.env  (git-ignored)
# Production: supabase secrets set --env-file ./supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# the Supabase Edge Runtime automatically — do not set them here.
# -----------------------------------------------------------------------------

# Stripe secret key (test mode: sk_test_...). Never expose to clients.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret of the webhook endpoint (Dashboard or `stripe listen`).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Base URL of the client application; used for Checkout/Portal redirects.
# Never taken from request input (prevents open redirects).
APP_URL=http://localhost:3000

# Shared secret for internal reconciliation calls to sync-subscription
# (header: x-internal-sync-secret). Use a long random value.
INTERNAL_SYNC_SECRET=replace-with-a-long-random-string
