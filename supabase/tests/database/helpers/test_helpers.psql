-- =============================================================================
-- pgTAP test helpers
--
-- Included by every test file with `\ir helpers/test_helpers.psql` *inside*
-- the file's transaction, so the helpers (and all fixtures) are rolled back
-- together with the test. The `.psql` extension keeps pg_prove from running
-- this file as a test.
--
-- Authentication is simulated exactly like PostgREST does it: by switching to
-- the `authenticated` / `anon` / `service_role` role and setting
-- `request.jwt.claims`. Every statement executed after tests.authenticate_as()
-- is therefore subject to real RLS policies and table/column privileges.
-- =============================================================================

create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

create table tests.fixtures (
  name text primary key,
  id   uuid not null
);

-- Fixture lookup usable from any role.
create function tests.id(p_name text)
returns uuid
language plpgsql
stable
security definer
set search_path = ''
as $$
declare
  v_id uuid;
begin
  select f.id into v_id from tests.fixtures f where f.name = p_name;
  if v_id is null then
    raise exception 'Unknown test fixture "%"', p_name;
  end if;
  return v_id;
end;
$$;

-- -----------------------------------------------------------------------------
-- Users
-- -----------------------------------------------------------------------------
create function tests.create_user(
  p_name      text,
  p_email     text default null,
  p_confirmed boolean default true,
  p_anonymous boolean default false
)
returns uuid
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
    raw_app_meta_data, raw_user_meta_data, created_at, updated_at, is_anonymous
  ) values (
    '00000000-0000-0000-0000-000000000000', v_id, 'authenticated', 'authenticated',
    case when p_anonymous then null else lower(coalesce(p_email, p_name || '@example.test')) end,
    '', case when p_confirmed then now() end,
    '{"provider": "email", "providers": ["email"]}'::jsonb,
    jsonb_build_object('full_name', initcap(p_name)),
    now(), now(), p_anonymous
  );

  insert into tests.fixtures (name, id) values (p_name, v_id);
  return v_id;
end;
$$;

create function tests.authenticate_as(p_name text)
returns void
language plpgsql
as $$
declare
  v_id        uuid := tests.id(p_name);
  v_email     text;
  v_anonymous boolean;
begin
  perform set_config('role', 'postgres', true);
  select u.email, u.is_anonymous into v_email, v_anonymous from auth.users u where u.id = v_id;

  perform set_config('request.jwt.claims', json_build_object(
    'sub', v_id,
    'role', 'authenticated',
    'aud', 'authenticated',
    'email', v_email,
    'is_anonymous', v_anonymous,
    'aal', 'aal1'
  )::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create function tests.authenticate_as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '{"role": "anon"}', true);
  perform set_config('role', 'anon', true);
end;
$$;

create function tests.authenticate_as_service_role()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '{"role": "service_role"}', true);
  perform set_config('role', 'service_role', true);
end;
$$;

-- Back to the test runner's own role (postgres) with no JWT claims.
create function tests.clear_authentication()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- -----------------------------------------------------------------------------
-- Tenant fixtures (inserted directly, bypassing RPCs, as the test runner)
-- -----------------------------------------------------------------------------
create function tests.create_org(p_name text, p_owner text)
returns uuid
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_id uuid;
begin
  insert into public.organizations (name, slug, created_by)
  values (initcap(p_name), lower(p_name) || '-' || substr(md5(random()::text), 1, 6), tests.id(p_owner))
  returning id into v_id;

  insert into public.organization_members (organization_id, user_id, role)
  values (v_id, tests.id(p_owner), 'owner');

  insert into tests.fixtures (name, id) values (p_name, v_id);
  return v_id;
end;
$$;

create function tests.add_member(p_org text, p_user text, p_role public.organization_role default 'member')
returns void
language sql
security definer
set search_path = ''
as $$
  insert into public.organization_members (organization_id, user_id, role)
  values (tests.id(p_org), tests.id(p_user), p_role)
$$;

create function tests.create_project(p_name text, p_org text, p_creator text)
returns uuid
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_id uuid;
begin
  insert into public.projects (organization_id, name, created_by)
  values (tests.id(p_org), initcap(p_name), tests.id(p_creator))
  returning id into v_id;

  insert into tests.fixtures (name, id) values (p_name, v_id);
  return v_id;
end;
$$;

-- -----------------------------------------------------------------------------
-- Assertions support
-- -----------------------------------------------------------------------------
-- Number of rows a DML statement touched *under the current role* (RLS makes
-- unauthorized UPDATE/DELETE silently affect zero rows).
create function tests.rows_affected(p_sql text)
returns integer
language plpgsql
as $$
declare
  v_count integer;
begin
  execute p_sql;
  get diagnostics v_count = row_count;
  return v_count;
end;
$$;

grant select on tests.fixtures to anon, authenticated, service_role;
